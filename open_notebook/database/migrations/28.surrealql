-- Migration 28: Docling vision endpoint fields in Settings (#1561)
-- content_settings lives on the SCHEMALESS `open_notebook` table, so the new
-- fields need no DEFINE FIELD. Backfill explicit NULLs on the existing settings
-- record so operators see the fields are unset (the CCORE_DOCLING_VISION_*
-- worker variables apply) instead of a missing key. On fresh installs the
-- record does not exist yet and the Pydantic ContentSettings defaults (None)
-- apply on first read. The API key is deliberately not stored here.

UPDATE open_notebook:content_settings SET docling_vision_url = NULL WHERE docling_vision_url = NONE;
UPDATE open_notebook:content_settings SET docling_vision_model = NULL WHERE docling_vision_model = NONE;
UPDATE open_notebook:content_settings SET docling_vision_prompt = NULL WHERE docling_vision_prompt = NONE;
