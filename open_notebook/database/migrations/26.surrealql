-- Migration 26: vector and text search order and limit after grouping
-- (#1431, #1505)
--
-- fn::vector_search grouped, ordered and limited in a single SELECT. SurrealDB
-- returns grouped rows in group-key order, so the ORDER BY was inert and the
-- LIMIT truncated a list ordered by record id. Because `note:` sorts before
-- `source:` and `source_insight:`, any $match_count below the number of
-- embedded notes returned notes ONLY -- dropping sources that scored higher
-- than every note in the result, with no error and no indication that anything
-- had been filtered.
--
-- The fix splits the final statement: group first, then order and limit over
-- the grouped set. The signature is unchanged, including the optional
-- $notebook_ids added in migration 24, and every branch above the final
-- statement is reproduced verbatim from 24.
--
-- #1306 re-sorts the rows that come back in Python, which corrects the visible
-- ordering but cannot recover rows the LIMIT has already discarded.

REMOVE FUNCTION IF EXISTS fn::vector_search;

DEFINE FUNCTION IF NOT EXISTS fn::vector_search($query: array<float>, $match_count: int, $sources: bool, $show_notes: bool, $min_similarity: float, $notebook_ids: option<array<record<notebook>>>) {

    let $scoped = $notebook_ids != NONE AND array::len($notebook_ids) > 0;
    let $scoped_sources = IF $scoped { (SELECT VALUE in FROM reference WHERE out IN $notebook_ids) } ELSE { [] };
    let $scoped_notes = IF $scoped { (SELECT VALUE in FROM artifact WHERE out IN $notebook_ids) } ELSE { [] };

    let $source_embedding_search =
        IF $sources {(
            SELECT
                source.id as id,
                source.title as title,
                content,
                source.id as parent_id,
                vector::similarity::cosine(embedding, $query) as similarity
            FROM source_embedding
            WHERE embedding != none and array::len(embedding)=array::len($query) AND
                 vector::similarity::cosine(embedding, $query) >= $min_similarity
              AND (!$scoped OR source IN $scoped_sources)
            ORDER BY similarity DESC
            LIMIT $match_count
        )}
        ELSE { [] };

    let $source_insight_search =
        IF $sources {(
            SELECT
                id,
                insight_type + ' - ' + (source.title OR '') as title,
                content,
                source.id as parent_id,
                vector::similarity::cosine(embedding, $query) as similarity
            FROM source_insight
             WHERE embedding != none and array::len(embedding)=array::len($query) AND
            vector::similarity::cosine(embedding, $query) >= $min_similarity
              AND (!$scoped OR source IN $scoped_sources)
            ORDER BY similarity DESC
            LIMIT $match_count
        )}
        ELSE { [] };


    let $note_content_search =
        IF $show_notes {(
            SELECT
                id,
                title,
                content,
                id as parent_id,
                vector::similarity::cosine(embedding, $query) as similarity
            FROM note
            WHERE embedding != none and array::len(embedding)=array::len($query) AND
            vector::similarity::cosine(embedding, $query) >= $min_similarity
              AND (!$scoped OR id IN $scoped_notes)
            ORDER BY similarity DESC
            LIMIT $match_count
        )}
        ELSE { [] };


    let $all_results = array::union(
        array::union($source_embedding_search, $source_insight_search),
        $note_content_search
    );


    -- Group FIRST, then order and limit over the grouped set.
    --
    -- The previous form did all three in one SELECT. SurrealDB returns grouped
    -- rows in group-key order, so the trailing ORDER BY had no effect and LIMIT
    -- truncated an id-ordered list -- and `note:` sorts before `source:` and
    -- `source_insight:`. Any $match_count below the number of embedded notes
    -- therefore returned notes only, silently discarding sources that scored
    -- higher than every note returned (#1431).
    let $grouped = (SELECT id, parent_id, title, math::max(similarity) AS similarity,
                           array::flatten(content) AS matches
                    FROM $all_results
                    WHERE id IS NOT NONE
                    GROUP BY id, parent_id, title);

    -- `id` breaks ties so equal similarities order deterministically, matching
    -- the Python re-sort added in #1306.
    RETURN (SELECT * FROM $grouped ORDER BY similarity DESC, id ASC LIMIT $match_count);

};

-- fn::text_search (last defined in migration 25) ended with the same
-- single-statement group/order/limit (#1505). Every branch above the final
-- statement is reproduced verbatim from 25.

REMOVE FUNCTION IF EXISTS fn::text_search;

DEFINE FUNCTION IF NOT EXISTS fn::text_search($query_text: string, $match_count: int, $sources: bool, $show_notes: bool, $notebook_ids: option<array<record<notebook>>>) {

    let $scoped = $notebook_ids != NONE AND array::len($notebook_ids) > 0;
    let $scoped_sources = IF $scoped { (SELECT VALUE in FROM reference WHERE out IN $notebook_ids) } ELSE { [] };
    let $scoped_notes = IF $scoped { (SELECT VALUE in FROM artifact WHERE out IN $notebook_ids) } ELSE { [] };

    let $source_title_search =
        IF $sources {(
            SELECT id, title,
            search::highlight('`', '`', 1) as content,
            id as parent_id,
            math::max(search::score(1)) AS relevance
            FROM source
            WHERE title @1@ $query_text
              AND (!$scoped OR id IN $scoped_sources)
            GROUP BY id)}
        ELSE { [] };

    let $source_embedding_search =
         IF $sources {(
            SELECT source.id as id, source.title as title, search::highlight('`', '`', 1) as content, source.id as parent_id, math::max(search::score(1)) AS relevance
            FROM source_embedding
            WHERE content @1@ $query_text
              AND (!$scoped OR source IN $scoped_sources)
            GROUP BY id)}
        ELSE { [] };

    let $source_full_search =
         IF $sources {(
            SELECT id, title, search::highlight('`', '`', 1) as content, id as parent_id, math::max(search::score(1)) AS relevance
            FROM source
            WHERE full_text @1@ $query_text
              AND (!$scoped OR id IN $scoped_sources)
            GROUP BY id)}
        ELSE { [] };

    let $source_insight_search =
         IF $sources {(
             SELECT id, insight_type + " - " + (source.title OR '') as title, search::highlight('`', '`', 1) as content, source.id as parent_id,  math::max(search::score(1)) AS relevance
            FROM source_insight
            WHERE content @1@ $query_text
              AND (!$scoped OR source IN $scoped_sources)
            GROUP BY id)}
        ELSE { [] };

    let $note_title_search =
         IF $show_notes {(
             SELECT id, title, search::highlight('`', '`', 1) as content,  id as parent_id, math::max(search::score(1)) AS relevance
            FROM note
            WHERE title @1@ $query_text
              AND (!$scoped OR id IN $scoped_notes)
            GROUP BY id)}
        ELSE { [] };

     let $note_content_search =
         IF $show_notes {(
             SELECT id, title, search::highlight('`', '`', 1) as content,  id as parent_id, math::max(search::score(1)) AS relevance
            FROM note
            WHERE content @1@ $query_text
              AND (!$scoped OR id IN $scoped_notes)
            GROUP BY id)}
        ELSE { [] };

    let $source_chunk_results = array::union($source_embedding_search, $source_full_search);

    let $source_asset_results = array::union($source_title_search, $source_insight_search);

    let $source_results = array::union($source_chunk_results, $source_asset_results );
    let $note_results = array::union($note_title_search, $note_content_search );
    let $final_results = array::union($source_results, $note_results );

    -- Group FIRST, then order and limit over the grouped set, for the same
    -- reason as fn::vector_search above (#1505). Unlike vector search, nothing
    -- re-sorts these rows in Python, so the id-ordered result reached callers
    -- as-is. The returned fields are unchanged.
    let $grouped = (select id, parent_id, title, math::max(relevance) as relevance
        from $final_results where id is not None
        group by id, parent_id, title);

    RETURN (SELECT * FROM $grouped ORDER BY relevance DESC, id ASC LIMIT $match_count);

};
